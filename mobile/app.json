      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#667eea"
      },
      "package": "com.rainshield.app"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "213395f0-d104-4664-9a09-2a3f1e837ca1"
      }
    }
  }
}
